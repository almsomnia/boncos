{
   "name": "boncos",
   "description": "A sophisticated bill-splitting and expense calculator built with Nuxt 4.",
   "version": "1.7.0",
   "type": "module",
   "private": true,
   "repository": {
      "type": "git",
      "url": "https://github.com/almsomnia/boncos"
   },
   "author": {
      "name": "Riva Almero",
      "email": "rivaalms@proton.me",
      "url": "https://github.com/almsomnia"
   },
   "scripts": {
      "build": "nuxt build",
      "dev": "nuxt dev",
      "generate": "nuxt generate",
      "preview": "nuxt preview",
      "postinstall": "nuxt prepare",
      "format": "prettier --write .",
      "release": "commit-and-tag-version && git push --follow-tags",
      "release:major": "commit-and-tag-version --release-as major && git push --follow-tags",
      "release:minor": "commit-and-tag-version --release-as minor && git push --follow-tags",
      "release:patch": "commit-and-tag-version --release-as patch && git push --follow-tags",
      "test:unit": "bunx vitest --project unit",
      "test:nuxt": "bunx vitest --project nuxt",
      "test": "bunx vitest"
   },
   "overrides": {
      "markdown-it": ">=14.1.1",
      "devalue": ">=5.6.3",
      "fast-xml-parser": ">=5.3.8",
      "tar": ">=7.5.8",
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0"
   },
   "dependencies": {
      "@nuxt/fonts": "0.13.0",
      "@nuxt/ui": "4.8.1",
      "@nuxtjs/seo": "^5.3.16",
      "nuxt": "^4.5.2",
      "tailwindcss": "^4.3.3",
      "typescript": "^5.9.3",
      "vue": "^3.5.43",
      "vue-router": "^4.6.4"
   },
   "devDependencies": {
      "@iconify-json/lucide": "^1.2.137",
      "@nuxt/icon": "^2.5.1",
      "@nuxt/test-utils": "^3.23.0",
      "@nuxtjs/i18n": "^10.6.0",
      "@types/node": "^20.19.43",
      "@vue/test-utils": "^2.5.1",
      "@vueuse/core": "^14.4.0",
      "@vueuse/nuxt": "^14.4.0",
      "commit-and-tag-version": "^13.2.1",
      "happy-dom": "^20.14.5",
      "prettier": "^3.9.9",
      "prettier-plugin-tailwindcss": "^0.7.4",
      "vitest": "^4.1.11"
   },
   "license": "MIT",
   "trustedDependencies": [
      "@parcel/watcher"
   ]
}
